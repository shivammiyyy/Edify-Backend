# Copy this file to .env and fill in the OAuth values before starting the stack.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-new-google-client-secret
APP_ADMIN_EMAIL=your-verified-google-email

# Development-only database password; choose a strong value outside development.
DATABASE_PASSWORD=rag_app_dev_password
REDIS_URL=redis://localhost:6379
EMBEDDING_CACHE_TTL=PT168H
DOCUMENTS_PER_MINUTE=10
MESSAGES_PER_MINUTE=20

AI_PROVIDER=ollama
LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=qwen3:8b
LLM_API_KEY=
EMBEDDINGS_URL=http://localhost:11434/api/embeddings
EMBEDDINGS_MODEL=qwen3-embedding:0.6b
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSION=1024
LLM_TIMEOUT=PT90S
EMBEDDINGS_TIMEOUT=PT60S

# Local MinIO object storage. These localhost URLs are for running Spring Boot natively;
# docker-compose.yml overrides internal service URLs for its containers.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=edify-local-access
OBJECT_STORAGE_SECRET_KEY=edify-local-secret
OBJECT_STORAGE_BUCKET=edify-documents

# Local Kafka broker for asynchronous ingestion
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Optional overrides when running the containerized stack.
# DOCKER_LLM_URL=http://ollama:11434/api/chat
# DOCKER_EMBEDDINGS_URL=http://ollama:11434/api/embeddings
