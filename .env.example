# Copy this file to .env and fill in the OAuth values before starting the stack.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-new-google-client-secret
APP_ADMIN_EMAIL=your-verified-google-email

# Development-only database password; choose a strong value outside development.
DATABASE_PASSWORD=rag_app_dev_password

LLM_MODEL=qwen3:8b
EMBEDDINGS_MODEL=qwen3-embedding:0.6b
EMBEDDINGS_DIMENSION=1024
